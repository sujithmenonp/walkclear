---
// Privacy-friendly analytics, only loaded when configured.
// Set PUBLIC_PLAUSIBLE_DOMAIN=walkclear.com (Plausible) or PUBLIC_CF_BEACON=<token> (Cloudflare Web Analytics).
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const cf = import.meta.env.PUBLIC_CF_BEACON;
---
{plausible && <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
{cf && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cf })}></script>}
