---
import { getVisibleNotes } from '../lib/notes';
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
const notes = (await getVisibleNotes()).slice(0, 6);
---
<Base>
	<h1>Learning system design, in the open.</h1>
	<p>Notes, diagrams and walkthroughs as I work through system design. Pages are living notes: I start with a rough explanation and keep adding context as I understand more.</p>
	<h2>Recently updated</h2>
	{notes.map((note) => <NoteCard {note} />)}
	<p><a href="/notes">All notes →</a></p>
</Base>
