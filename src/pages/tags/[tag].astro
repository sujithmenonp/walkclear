---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteCard from '../../components/NoteCard.astro';
export async function getStaticPaths() {
	const notes = await getCollection('notes', (n) => !n.data.hidden);
	const tags = [...new Set(notes.flatMap((n) => n.data.tags))];
	return tags.map((tag) => ({ params: { tag }, props: { notes: notes.filter((n) => n.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { notes } = Astro.props;
---
<Base title={`#${tag}`}>
	<h1>Tagged “{tag}”</h1>
	{notes.map((note) => <NoteCard {note} />)}
	<p><a href="/notes">← All notes</a></p>
</Base>
