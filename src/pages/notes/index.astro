---
import Base from '../../layouts/Base.astro';
import NoteCard from '../../components/NoteCard.astro';
import { groups, getVisibleNotes } from '../../lib/notes';
const notes = await getVisibleNotes();
const tags = [...new Set(notes.flatMap((n) => n.data.tags))].sort();
---
<Base title="Notes">
	<h1>Notes</h1>
	<p>{tags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}</p>
	{groups.map((g) => {
		const items = notes.filter((n) => n.data.type === g.type);
		return items.length > 0 && (
			<>
				<h2 class="group">{g.label}</h2>
				{items.map((note) => <NoteCard {note} />)}
			</>
		);
	})}
</Base>
