---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Subscribe from '../components/Subscribe.astro';
import Sidebar from '../components/Sidebar.astro';
const { title, description = 'Notes on system design, written while I learn it.' } = Astro.props;
const pageTitle = title ? `${title} · walkclear` : 'walkclear';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="walkclear" href="/rss.xml" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		<Analytics />
		<slot name="head" />
	</head>
	<body>
		<header class="site">
			<div class="wrap">
				<a class="brand" href="/"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4f46e5"/><stop offset="1" stop-color="#0d9488"/></linearGradient></defs><rect width="32" height="32" rx="9" fill="url(#g)"/><path d="M6 20c4-8 7-8 10 0s6 8 10 0" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>walkclear</a>
				<nav><a href="/notes">Notes</a><a href="/search" title="Search (Ctrl/Cmd+K)">Search</a><a href="/about">About</a><a href="/rss.xml">RSS</a></nav>
			</div>
		</header>
		<div class="layout">
			<Sidebar />
			<main>
				<slot />
				<Subscribe />
			</main>
		</div>
		<footer class="site"><div class="wrap">© {new Date().getFullYear()} walkclear.com · learning system design in public</div></footer>
		<script is:inline>
			document.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); location.href = '/search'; }
			});
		</script>
	</body>
</html>
